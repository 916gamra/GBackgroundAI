{
  "name": "gbackgroundai",
  "private": true,
  "version": "15.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gbai-tests/logic.mjs --log-level=error --external:chart.js/auto && node node_modules/.cache/gbai-tests/logic.mjs",
    "smoke": "esbuild tests/smoke-render.tsx --bundle --platform=node --format=cjs --loader:.css=empty --external:chart.js/auto --outfile=node_modules/.cache/gbai-tests/smoke.cjs --log-level=error && node node_modules/.cache/gbai-tests/smoke.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.14",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
